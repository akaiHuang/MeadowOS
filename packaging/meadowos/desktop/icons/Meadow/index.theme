[Icon Theme]
Name=Meadow
Comment=Original MeadowOS native desktop icons
Inherits=Adwaita,hicolor
Example=system-file-manager
Directories=scalable/apps,scalable/places,scalable/actions,scalable/mimetypes,scalable/devices,scalable/status

[scalable/apps]
Size=48
Type=Scalable
MinSize=8
MaxSize=512
Context=Applications

[scalable/places]
Size=24
Type=Scalable
MinSize=8
MaxSize=512
Context=Places

[scalable/actions]
Size=24
Type=Scalable
MinSize=8
MaxSize=512
Context=Actions

[scalable/mimetypes]
Size=48
Type=Scalable
MinSize=8
MaxSize=512
Context=MimeTypes

[scalable/devices]
Size=24
Type=Scalable
MinSize=8
MaxSize=512
Context=Devices

[scalable/status]
Size=24
Type=Scalable
MinSize=8
MaxSize=512
Context=Status
